+import { useNavigation } from "@react-navigation/native";
+
+const styles = {
+  container:
+    "flex h-full w-full items-center justify-center bg-slate-950 px-6",
+
+  card:
+    "w-full max-w-[440px] rounded-3xl border border-slate-800 bg-slate-900 px-7 py-8",
+
+  eyebrow:
+    "mb-2 text-center text-xs font-semibold uppercase tracking-[2px] text-sky-400",
+
+  title:
+    "mb-3 text-center text-3xl font-bold tracking-tight text-white",
+
+  subtitle:
+    "mb-7 text-center text-sm leading-6 text-slate-400",
+
+  divider:
+    "mb-5 h-px w-full bg-slate-800",
+
+  button:
+    "flex w-full items-center rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 cursor-pointer",
+
+  buttonText:
+    "text-sm font-semibold text-slate-200",
+};
+
+export function Settings() {
+  const navigation = useNavigation();
+
+  return (
+    <main className={styles.container}>
+      <section className={styles.card}>
+        <p className={styles.eyebrow}>Navigation Demo</p>
+
+        <h1 className={styles.title}>Settings</h1>
+
+        <p className={styles.subtitle}>
+          This screen only exists to prove the stack navigator works the
+          same way on mobile and desktop.
+        </p>
+
+        <div className={styles.divider} />
+
+        <button
+          type="button"
+          className={styles.button}
+          onClick={() => navigation.goBack()}
+        >
+          <span className={styles.buttonText}>← Back to Home</span>
+        </button>
+      </section>
+    </main>
+  );
+}