+++ b/packages/shared/src/screens/Settings.tsx
@@ -0,0 +1,56 @@
+import { Pressable, Text, View } from "react-native";
+import { useNavigation } from "@react-navigation/native";
+
+const styles = {
+  container:
+    "flex-1 items-center justify-center bg-slate-950 px-6",
+
+  card:
+    "w-full rounded-3xl border border-slate-800 bg-slate-900 px-7 py-8",
+
+  eyebrow:
+    "mb-2 text-center text-xs font-semibold uppercase tracking-[2px] text-sky-400",
+
+  title:
+    "mb-3 text-center text-3xl font-bold tracking-tight text-white",
+
+  subtitle:
+    "mb-7 text-center text-sm leading-6 text-slate-400",
+
+  divider:
+    "mb-5 h-px w-full bg-slate-800",
+
+  button:
+    "items-center rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3",
+
+  buttonText:
+    "text-sm font-semibold text-slate-200",
+};
+
+export function Settings() {
+  const navigation = useNavigation();
+
+  return (
+    <View className={styles.container}>
+      <View className={styles.card}>
+        <Text className={styles.eyebrow}>Navigation Demo</Text>
+
+        <Text className={styles.title}>Settings</Text>
+
+        <Text className={styles.subtitle}>
+          This screen only exists to prove the stack navigator works the
+          same way on mobile and desktop.
+        </Text>
+
+        <View className={styles.divider} />
+
+        <Pressable
+          className={styles.button}
+          onPress={() => navigation.goBack()}
+        >
+          <Text className={styles.buttonText}>← Back to Home</Text>
+        </Pressable>
+      </View>
+    </View>
+  );
+}
